# Environment Configuration Example
PROJECT_NAME="Personal Finance Agent"
ENVIRONMENT=development
DEBUG=true

# Database Connection (SQLite default for local dev; Postgres for production)
DATABASE_URL=sqlite:///./personal_finance.db
# DATABASE_URL=postgresql://finance_user:finance_secure_password_123@localhost:5432/personal_finance

# Security & Secret Keys
SECRET_KEY=change_this_to_a_secure_random_32byte_string_in_production
ENCRYPTION_KEY=u6N_4kL-p1B9y8W2z3X4v5G6h7J8k9L0m1N2o3P4q5R=

# Gemini AI API Key (Optional: system works in fallback mode if blank)
